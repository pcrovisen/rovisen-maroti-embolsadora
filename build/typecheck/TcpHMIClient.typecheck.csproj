<!--
  Compile-only shadow project for TcpHMIClient/ — see the header of
  ModbusServer.typecheck.csproj for what this is and is not.

  The .resx files are deliberately not compiled: Resources.Designer.cs looks its
  resources up by name at runtime, so leaving them out costs nothing here and
  avoids depending on GenerateResource behaving the same off Windows. The real
  build still embeds them.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>TcpHMIClient.typecheck</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);NU1902;NU1903</NoWarn>
    <Src>$(MSBuildThisFileDirectory)../../TcpHMIClient</Src>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(Src)/**/*.cs" Exclude="$(Src)/obj/**;$(Src)/bin/**" />
    <!-- The shared wire contract. Top level only — its Properties/AssemblyInfo.cs
         would duplicate the assembly attributes of the project under test. -->
    <Compile Include="$(MSBuildThisFileDirectory)../../Contracts/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="System.Text.Json" Version="7.0.0" />
    <Reference Include="System.Configuration" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

</Project>
